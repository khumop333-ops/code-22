# ---- LLM endpoint (OpenAI-compatible, e.g. Ollama on a Kaggle tunnel) ----
# Base URL of the OpenAI-compatible API (include the /v1 suffix)
LLM_BASE_URL=https://distributed-guide-monitors-reached.trycloudflare.com/v1
# Model ID as exposed by the endpoint
LLM_MODEL_ID=hf.co/huihui-ai/Huihui-Qwen3.8-27B-abliterated-GGUF:Q4_K_M
# Bearer token sent to the endpoint (Ollama accepts anything, e.g. "ollama")
LLM_API_KEY=ollama

# ---- Supabase (server-side only, never exposed to the browser) ----
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://hnxmpdnfbliixrwttjkk.supabase.co
# service_role key — bypasses RLS, keep secret, server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
